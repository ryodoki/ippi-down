            "compression": 0,
            "text": "\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\n<html lang=\"ja\">\n\t<head>\n\t\t<title>入札情報サービス 検索条件指定</title>\n\t\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=Shift_JIS\" />\n\t\t<meta content=\"Microsoft Visual Studio .NET 7.1\" name=\"GENERATOR\" />\n\t\t<meta content=\"C#\" name=\"CODE_LANGUAGE\" />\n\t\t<meta content=\"JavaScript\" name=\"vs_defaultClientScript\" />\n\t\t<meta content=\"http://schemas.microsoft.com/intellisense/ie5\" name=\"vs_targetSchema\" />\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"../../css/main.css\" />\n\t\t<script type=\"text/javascript\">\n            function new_win(url) {\n                selectWin = window.open(url, \"subListWin\", \"width=800px,height=600,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no\");\n                selectWin.focus();\n\t\t\t}\n\n            //------------------------------------------------\n            //関数：setListItemSub()\n            //------------------------------------------------\t\t\n            function setListItemSub(SEL, LIST) {\n                var SELObj = document.getElementById(SEL);\n                var selindex = SELObj.selectedIndex;\n\n                if (LIST) {\n                    for (var i = 0; LIST[i]; i++) {\n                        var OPT = document.createElement('option');\n                        //リスト情報の取得\n                        var listitem = LIST[i].split(\":\");\n                        //リストの値を設定\n                        OPT.value = listitem[0];\n                        //リストの表示値を設定\n                        OPT.appendChild(document.createTextNode(listitem[1]));\n                        SELObj.appendChild(OPT);\n                    }\n                }\n\t\t\t}\n\n            //------------------------------------------------\n            //関数：sizeChangeTarget()\n            //------------------------------------------------\t\n            function sizeChangeTarget() {\n                var arrayEle = [];\n\n                // 文字の大きさを変更する要素\n                arrayEle.push(document.getElementById('tblSearch'));\n\t\t\t\tarrayEle.push(document.getElementById('Table3'));\n\t\t\t\tif (document.getElementById('lblErrorMes') != null) {\n                    arrayEle.push(document.getElementById('lblErrorMes'));\n\t\t\t\t}\n\t\t\t\tvar selectEle = document.getElementsByTagName('select');\n\t\t\t\tArray.prototype.forEach.call(selectEle, function (ele) {\n\t\t\t\t\tarrayEle.push(ele);\n\t\t\t\t});\n\t\t\t\tvar textEle = document.querySelectorAll(\"input[type=text]\");\n\t\t\t\tArray.prototype.forEach.call(textEle, function (ele) {\n\t\t\t\t\tarrayEle.push(ele);\n\t\t\t\t});\n\t\t\t\tchangeFontClass(arrayEle);\n\n                // 画面のフォントサイズちらつき対策\n                document.body.style.display = 'block';\n\t\t\t}\n        </script>\n\t</head>\n\n\t<body MS_POSITIONING=\"GridLayout\" onload=\"checkObjWin2('koji')\" style=\"display:none;\">\n\t\t<form name=\"Form1\" method=\"post\" action=\"./Search.aspx?tab=4\" id=\"Form1\" onkeydown=\"if(event.keyCode==13){ return false;}\">\r\n<input type=\"hidden\" name=\"__EVENTTARGET\" id=\"__EVENTTARGET\" value=\"\" />\r\n<input type=\"hidden\" name=\"__EVENTARGUMENT\" id=\"__EVENTARGUMENT\" value=\"\" />\r\n<input type=\"hidden\" name=\"__LASTFOCUS\" id=\"__LASTFOCUS\" value=\"\" />\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n\r\n<script type=\"text/javascript\">\r\n<!--\r\nvar theForm = document.forms['Form1'];\r\nif (!theForm) {\r\n    theForm = document.Form1;\r\n}\r\nfunction __doPostBack(eventTarget, eventArgument) {\r\n    if (!theForm.onsubmit || (theForm.onsubmit() != false)) {\r\n        theForm.__EVENTTARGET.value = eventTarget;\r\n        theForm.__EVENTARGUMENT.value = eventArgument;\r\n        theForm.submit();\r\n    }\r\n}\r\n// -->\r\n</script>\r\n\r\n\r\n\r\n<script src=\"/IPPI/SearchServices/ScriptResource.axd?d=LqrLRJqA1oL7f8MlScETIlSpXjh2465mUJYAGuA4mYX-jmzJlUbTlCrMeyoncTbwHsBUNFcgpHtOvFLb-faAuG6NQube_KZukqn2EKw5rMWuD_I51v42okjBoFt7EY-_4OuNLidpM4m995eNyOh_X-4vR2Q1&amp;t=b990ecd\" type=\"text/javascript\"></script>\r\n<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"5E7F70DD\" />\n\t\t\t\n\t\t\t<div align=\"left\">\n\t\t\t\t<div id=\"UpdatePanel1\" style=\"text-align: -webkit-center;\">\r\n\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div id=\"cssKoji\">\r\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"../../css/koji.css\" />\r\n\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t<LINK rel=\"stylesheet\" type=\"text/css\" href=\"../../css/ppi_main_base.css\">\r\n<LINK id=\"css\" rel=\"stylesheet\" type=\"text/css\" href=\"\">\r\n<script language=\"JavaScript\" type=\"text/javascript\" src=\"../../js/Common.js\"></script>\r\n<script src=\"../../js/Header.js\" type=\"text/javascript\"></script>\r\n<script type=\"text/javascript\">\r\n\tfunction new_winHelp(url) {\r\n\t\tselectWin = window.open(url, \"subList2Win\", \"width=650px,height=600,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no\");\r\n\t\tselectWin.focus();\r\n\t}\r\n</script>\r\n<div id=\"header_div\" class=\"print_header\">\r\n\t<table id=\"header_table\">\r\n\t\t<tr>\r\n\t\t\t<td rowspan=\"2\" id=\"header_block\">\r\n\t\t\t\t<a href=\"../../Index.htm\" target=\"_top\">\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<font id=\"ppi_title\">入札情報サービス</font><br>\r\n\t\t\t\t\t\t<font id=\"ppi_sub\">公共発注機関が公開する全国の入札情報を提供しています</font><br>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</a>\r\n\t\t\t</td>\r\n\t\t\t<td id=\"support_frm\">\r\n\t\t\t\t<div class=\"support_btn support_title\">文字の<br>大きさ</div>\r\n\t\t\t\t<a href=\"javascript:onClickLargeText()\"><span class=\"support_btn size_color_btn\">大</span></a>\r\n\t\t\t\t<a href=\"javascript:onClickMediumText()\"><span class=\"support_btn size_color_btn\">中</span></a>\r\n\t\t\t\t<a href=\"javascript:onClickSmallText()\"><span class=\"support_btn size_color_btn\" style=\"margin-righ
            "mimeType": "text/html; charset=utf-8",
            "compression": 0,
            "text": "\r\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\r\n<HTML lang=\"ja\">\r\n\t<HEAD>\r\n\t\t<title>入札情報サービス 入札の経過（工事）案件概要</title>\r\n\t\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=Shift_JIS\">\r\n\t\t<meta content=\"Microsoft Visual Studio .NET 7.1\" name=\"GENERATOR\">\r\n\t\t<meta content=\"C#\" name=\"CODE_LANGUAGE\">\r\n\t\t<meta content=\"JavaScript\" name=\"vs_defaultClientScript\">\r\n\t\t<meta content=\"http://schemas.microsoft.com/intellisense/ie5\" name=\"vs_targetSchema\">\r\n\t\t<LINK rel=\"stylesheet\" type=\"text/css\" href=\"../../css/main.css\">\r\n\t\t<LINK rel=\"stylesheet\" type=\"text/css\" href=\"../../css/koji.css\">\r\n\t\t<script type=\"text/javascript\">\r\n            //------------------------------------------------\r\n            //関数：sizeChangeTarget()\r\n            //------------------------------------------------\t\r\n            function sizeChangeTarget() {\r\n                var arrayEle = [];\r\n\r\n                // 文字の大きさを変更する要素\r\n                arrayEle.push(document.getElementById('tblDataHdr'));\r\n                var dataEle = document.getElementById('tblDataDtl').getElementsByTagName('tr');\r\n                Array.prototype.forEach.call(dataEle, function (ele) {\r\n                    arrayEle.push(ele);\r\n                });\r\n\r\n                arrayEle.push(document.getElementById('tblReference').querySelectorAll('tr')[1]);\r\n                arrayEle.push(document.getElementById('tblReference').querySelectorAll('tr')[3]);\r\n\r\n\t\t\t\tchangeFontClass(arrayEle);\r\n\r\n                // 画面のフォントサイズちらつき対策\r\n                document.body.style.display = 'block';\r\n            }\r\n        </script>\r\n\t\t<SCRIPT language=\"JavaScript\">\r\n\t\tfunction new_win1(){\r\n\t\t\t\r\n\t\t\tvar AnkenkanriNo = \"021020002024412000000374\";\r\n\t\t\tvar HachushaId = \"02102000\";\r\n\t\t\tselectWin = window.open(\"https://www.i-ppi.jp/IPPI/DownloadServices/Web/UserEntry_Download.aspx?data1=\" + AnkenkanriNo + \"&data2=\" + HachushaId, \"subList1Win\",\"width=650px,height=600,location=no,menubar=no,resizable=yes,scrollbars=yes,status=yes,toolbar=no\");\r\n\t\t　　selectWin.focus();\r\n\t\t}\r\n\t\t</SCRIPT>\r\n\t</HEAD>\r\n\t<body MS_POSITIONING=\"GridLayout\" style=\"display:none;\">\r\n\t\t<form name=\"Form1\" method=\"post\" action=\"List_Detail.aspx?tab=4\" id=\"Form1\">\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n\r\n<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"03924484\" />\r\n<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"\" />\r\n\t\t\t<div align=\"left\" style=\"text-align: -webkit-center;\">\r\n\t\t\t\t<LINK rel=\"stylesheet\" type=\"text/css\" href=\"../../css/ppi_main_base.css\">\r\n<LINK id=\"css\" rel=\"stylesheet\" type=\"text/css\" href=\"\">\r\n<script language=\"JavaScript\" type=\"text/javascript\" src=\"../../js/Common.js\"></script>\r\n<script src=\"../../js/Header.js\" type=\"text/javascript\"></script>\r\n<script type=\"text/javascript\">\r\n\tfunction new_winHelp(url) {\r\n\t\tselectWin = window.open(url, \"subList2Win\", \"width=650px,height=600,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no\");\r\n\t\tselectWin.focus();\r\n\t}\r\n</script>\r\n<div id=\"header_div\" class=\"print_header\">\r\n\t<table id=\"header_table\">\r\n\t\t<tr>\r\n\t\t\t<td rowspan=\"2\" id=\"header_block\">\r\n\t\t\t\t<a href=\"../../Index.htm\" target=\"_top\">\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<font id=\"ppi_title\">入札情報サービス</font><br>\r\n\t\t\t\t\t\t<font id=\"ppi_sub\">公共発注機関が公開する全国の入札情報を提供しています</font><br>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</a>\r\n\t\t\t</td>\r\n\t\t\t<td id=\"support_frm\">\r\n\t\t\t\t<div class=\"support_btn support_title\">文字の<br>大きさ</div>\r\n\t\t\t\t<a href=\"javascript:onClickLargeText()\"><span class=\"support_btn size_color_btn\">大</span></a>\r\n\t\t\t\t<a href=\"javascript:onClickMediumText()\"><span class=\"support_btn size_color_btn\">中</span></a>\r\n\t\t\t\t<a href=\"javascript:onClickSmallText()\"><span class=\"support_btn size_color_btn\" style=\"margin-right: 25px;\">小</span></a>\r\n\t\t\t\t<div class=\"support_btn support_title\">背景色と<br>文字色</div>\r\n\t\t\t\t<a href=\"javascript:onClickBlackText()\"><span class=\"support_btn size_color_btn color_selected\">黒</span></a>\r\n\t\t\t\t<a href=\"javascript:onClickWhiteText()\"><span class=\"support_btn size_color_btn color_w_b\">白</span></a>\r\n\t\t\t\t<a href=\"javascript:onClickYellowText()\"><span class=\"support_btn size_color_btn color_bl_y\" style=\"margin-right: 15px;\">黄</span></a>\r\n\t\t\t\t<div class=\"support_btn\" style=\"line-height:19px; color:white; padding-right: 12px; text-align: left;\">\r\n\t\t\t\t\t<a href=\"javascript:new_winHelp('../../help_search.htm');\" class=\"support_txt\"><span id=\"q_icon\">？</span>&nbsp;ヘルプ</a><br>\r\n\t\t\t\t\t<a href=\"mailto:i-ppi.helpdesk@jacic.or.jp\" class=\"support_txt\">&#x2709;&nbsp;お問い合わせ</a>\r\n\t\t\t\t</div>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\r\n\t\t<tr>\r\n\t\t\t<td style=\"width:812px; min-width: 812px; vertical-align: bottom; padding: 0px;\">\r\n\t\t\t\t<a href=\"../../Index.htm\" target=\"_top\"><span class=\"button_cls\">全国</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=1\" target=\"_top\"><span class=\"button_cls\">北海道</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=2\" target=\"_top\"><span class=\"button_cls\">東北</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=3\" target=\"_top\"><span class=\"button_cls\">関東</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=4\" target=\"_top\"><span class=\"button_cls\">北陸</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=5\" target=\"_top\"><span class=\"button_cls\">中部</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=6\" target=\"_top\"><span class=\"button_cls\">近畿</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=7\" target=\"_top\"><span class=\"button_cls\">中国</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=8\" target=\"_top\"><span class=\"button_cls\">四国</span></a>\r\n\t\t\t\t<a href=\"../../IndexArea.aspx?data1=9\" target=\"_top\"><span class=\"button_cls\">九州･沖縄</span></a>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n</div>\r\n\r\n\t\t\t\t<table id=\"Table1\" cellspacing=\"0\" cellpadding=\"0\" class=\"search\" border=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\r\n\t<tr>\r\n\t\t<td class=\"chuchoki tabtitle\">\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●</label>\r\n\t\t\t\t\t\t\t<label>中長期の検索</label>\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●</label>\r\n\t\t\t\t\t\t</td><td class=\"koji tabtitle\">\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●●●●●●●●●●</label>\r\n\t\t\t\t\t\t\t<label>工事の検索</label>\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●●●●●●●●●●</label>\r\n\t\t\t\t\t\t</td><td class=\"gyomu tabtitle\">\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●●●●●●●●●●</label>\r\n\t\t\t\t\t\t\t<label>業務の検索</label>\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●●●●●●●●●●</label>\r\n\t\t\t\t\t\t</td><td class=\"hachu tabtitle\">\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●</label>\r\n\t\t\t\t\t\t\t<label>発注機関の検索</label>\r\n\t\t\t\t\t\t\t<label class=\"tabtitletext\">●</label>\r\n\t\t\t\t\t\t</td>\r\n\t</tr><tr valign=\"bottom\" align=\"center\">\r\n\t\t<td class=\"chuchoki\"><input type=\"submit\" name=\"imgChuchokiMitoshi\" value=\"中長期発注見通し\" id=\"imgChuchokiMitoshi\" class=\"tab chuchokitab\" /></td><td class=\"koji\"><input type=\"submit\" name=\"imgKojiMitoshi\" value=\"発注の見通し\" id=\"imgKojiMitoshi\" class=\"tab kojitab\" /><input type=\"submit\" name=\"imgKojiKokoku\" value=\"入札公告等\" id=\"imgKojiKokoku\" class=\"tab kojitab\" /><input type=\"submit\" name=\"imgKojiKeika\" value=\"入札の経過\" id=\"imgKojiKeika\" class=\"tab selectkojitab\" /></td><td class=\"gyomu\"><input type=\"submit\" name=\"imgGyomuMitoshi\" value=\"発注の見通し\" id=\"imgGyomuMitoshi\" class=\"tab gyomutab\" /><input type=\"submit\" name=\"imgGyomuKokoku\" value=\"入札公告等\" id=\"imgGyomuKokoku\" class=\"tab gyomutab\" /><input type=\"submit\" name=\"imgGyomuKeika\" value=\"入札の経過\" id=\"imgGyomuKeika\" class=\"tab gyomutab\" /></td><td class=\"hachu\"><input type=\"submit\" name=\"imgHachuInf\" value=\"発注機関情報\" id=\"imgHachuInf\" class=\"tab hachutab\" /></td>\r\n\t</tr>\r\n</table>\r\n\t\t\t\t<table id=\"Table2\" cellspacing=\"0\" cellpadding=\"0\" class=\"search\" border=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\r\n\t<tr class=\"back_top\">\r\n\t\t<td colSpan=\"5\"></td>\r\n\t</tr><tr class=\"title_mid\">\r\n\t\t<td colSpan=\"5\">入札の経過（工事）案件概要</td>\r\n\t</tr>\r\n</table>\r\n\t\t\t\t<TABLE class=\"search\" id=\"tblDataHdr\" cellSpacing=\"0\" cellPadding=\"3\" border=\"1\" frame=\"box\"\r\n\t\t\t\t\tstyle=\"empty-cells:show\" width=\"1024\">\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD class=\"hdr\">発注機関</TD>\r\n\t\t\t\t\t\t<TD><span id=\"lblHachukikan\">国土交通省東北地方整備局</span></TD>\r\n\t\t\t\t\t</TR>\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD class=\"hdr\">担当部・事務所</TD>\r\n\t\t\t\t\t\t<TD><span id=\"lblHachusha\">総務部契約課</span></TD>\r\n\t\t\t\t\t</TR>\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD class=\"hdr\">工事名称</TD>\r\n\t\t\t\t\t\t<TD><span id=\"lblKojiNm\">国道７号　鼠ヶ関トンネル（２期）工事</span></TD>\r\n\t\t\t\t\t</TR>\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD class=\"hdr\" rowSpan=\"2\">工事場所</TD>\r\n\t\t\t\t\t\t<TD>自：\r\n\t\t\t\t\t\t\t<span id=\"lblKojiPlaceFrom\">山形県鶴岡市鼠ヶ関</span></TD>\r\n\t\t\t\t\t</TR>\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD>至：\r\n\t\t\t\t\t\t\t<span id=\"lblKojiPlaceTo\">山形県鶴岡市早田　地内</span></TD>\r\n\t\t\t\t\t</TR>\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD class=\"hdr\">入札契約方式</TD>\r\n\t\t\t\t\t\t<TD><span id=\"lblNyusatsuPtn\">随意契約</span></TD>\r\n\t\t\t\t\t</TR>\r\n\t\t\t\t\t<TR class=\"odd\">\r\n\t\t\t\t\t\t<TD class=\"hdr\">工事種別／工事の業種</TD>\r\
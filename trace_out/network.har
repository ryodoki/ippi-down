rder-radius: 8px 8px 0px 0px;\r\n\tmargin: 0px 1px;\r\n\tdisplay: inline-block;\r\n}\r\n\r\ninput[type=submit].tab {\r\n\tborder: none;\r\n\tfont-size: 12px;\r\n\tline-height: 20px;\r\n\tfont-weight: bold;\r\n\twidth: 110px;\r\n\theight: 20px;\r\n\tborder-radius: 8px 8px 0px 0px;\r\n\tmargin: 0px 2px;\r\n\tdisplay: inline-block;\r\n\tpadding: 0px;\r\n\tcursor: pointer\r\n}\r\n\r\n/* �G���[�̃X�^�C�� */\r\ndiv.err {\r\n\tcolor : Red ;\r\n}\r\n.errmsg {\r\n\tbackground-color : #FFC0FF ;\r\n\tcolor : Red ;\r\n\tmargin-left:12px;\r\n\twidth :960px ;\r\n}\r\n\r\n/* �\\�[�g���x���̃����N������ */\r\nth.nolink a {\r\n\tcursor: text;\r\n\tdisplay: inline-block;\r\n\tpointer-events: none;\r\n\ttext-decoration: none;\r\n}\r\n\r\n/* �\\�[�g�L���̕����T�C�Y */\r\nth span {\r\n\tfont-size: small;\r\n\tfont-weight: normal;\r\n}\r\n\r\n/* �\\�[�g�L���̃����N�L���� */\r\nth span a {\r\n\tcursor: pointer !important;\r\n\tpointer-events: auto !important;\r\n/* 2022.11.30 R4�@�\\���� YSL SYART */\r\n\t/* text-decoration: underline !important; */\r\n\ttext-decoration-line:none;\r\n/* 2022.11.30 R4�@�\\���� YSL END */\r\n}\r\n\r\n/* �\\�[�g�L���̃����N�F */\r\nth span a:link {\r\n\tcolor: #000000;\r\n}\r\n\r\n/* �\\�[�g�L���̃����Nhover */\r\nth span a:hover {\r\n\tcolor: #FFFFFF !important;\r\n}\r\n\r\n/* 2024.07.01 ��������X�g�����ǉ� --START-- */\r\n@media print{\r\n\t.back_white {\r\n\t\tbackground-color: white;\r\n\t}\r\n}\r\n/* 2024.07.01 ��������X�g�����ǉ� --END-- */\r\n"

            "text": "/* body ��{�X�^�C�� */\r\nbody {\r\n\tmargin: 0;\r\n\tpadding: 0 0 0 0;\r\n\tfont-size: 12px;\r\n\tfont-family: 'Meiryo','���C���I', sans-serif;\r\n}\r\n\r\na {\r\n\ttext-decoration: none;\r\n\tfont-weight: bold;\r\n}\r\n\r\n/* �r���i�ΐ��j */\r\n.hr_slash {\r\n\theight: 5px;\r\n\tbackground-size: 5px 5px;\r\n\tborder: none;\r\n}\r\n\r\n/* �t�H���g�T�C�Y�� */\r\n.font_large_cls {\r\n\tfont-size: 16px !important;\r\n}\r\n\r\n/* �t�H���g�T�C�Y�� */\r\n.font_medium_cls {\r\n\tfont-size: 14px !important;\r\n}\r\n\r\n/* �t�H���g�T�C�Y�� */\r\n.font_small_cls {\r\n\tfont-size: 12px !important;\r\n}\r\n\r\n\r\n/* �w�b�_ */\r\n/* �w�b�_�g */\r\n#header_div {\r\n\tmin-width: 1000px;\r\n\twidth: 100%;\r\n\theight: 72px;\r\n\tposition: fixed;\r\n\tz-index: 999;\r\n\ttop: 0;\r\n}\r\n\r\n#header_table {\r\n\twidth: 100%;\r\n\theight: 100%;\r\n}\r\n\r\n#header_block {\r\n\tdisplay: table-cell;\r\n\tpadding-left: 10px;\r\n\tvertical-align: middle;\r\n\tmin-width: 200px;\r\n}\r\n\r\n/* �^�C�g�� */\r\n#ppi_title {\r\n\ttext-shadow: 4px 3px 4px black;\r\n\tfont-size: 24px;\r\n\tfont-weight: normal;\r\n}\r\n\r\n/* �^�C�g���T�u */\r\n#ppi_sub {\r\n\ttext-shadow: 4px 3px 4px black;\r\n\tfont-size: 8pt;\r\n\tline-height: 12px;\r\n}\r\n\r\n/* �T�|�[�g�{�^���g�i���o�x���E�w���v�E�⍇���j */\r\n#support_frm {\r\n\tpadding: 2px 0;\r\n\ttext-align: right;\r\n\tvertical-align: top;\r\n}\r\n\r\n.support_btn {\r\n\tdisplay: inline-block;\r\n\tvertical-align: middle;\r\n}\r\n\r\n.size_color_btn {\r\n\twidth: 25px;\r\n\theight: 100%;\r\n\tborder: solid 1px gray;\r\n\ttext-align: center;\r\n\tbackground-color: white;\r\n\tfont-size: 16px;\r\n\tcolor: black;\r\n}\r\n\r\n#q_icon {\r\n\tdisplay: inline-block;\r\n\tcolor: #039;\r\n\tbackground: white;\r\n\tborder-radius: 50%;\r\n\tfont-size: 9px;\r\n\twidth: 14px;\r\n\theight: 14px;\r\n\ttext-align: center;\r\n}\r\n\r\n.size_selected {\r\n\tborder: solid 2px white;\r\n\tbackground: cadetblue;\r\n\tcolor: white;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.color_selected {\r\n\tborder: solid 2px coral;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.color_w_b {\r\n\tbackground-color: black;\r\n\tcolor: white;\r\n}\r\n\r\n.color_bl_y {\r\n\tbackground-color: #327EC4;\r\n\tcolor: yellow;\r\n}\r\n\r\n#support_frm > a {\r\n\tfont-size: 16px;\r\n}\r\n\r\n/* �n���{�^�� */\r\n.button_cls {\r\n\tdisplay: inline-block;\r\n\twidth: 79px;\r\n\theight: 21px;\r\n\tfloat: left;\r\n\tpadding-top: 2px;\r\n\tborder: 1px solid red;\r\n\tborder-color: aliceblue black black lightsteelblue;\r\n\ttext-align: center;\r\n\tfont-weight: bold;\r\n}\r\n\r\n/* �n���{�^���}�E�X�I�[�o�[ */\r\n.button_cls:hover {\r\n\ttransition: .1s;\r\n}\r\n\r\n.support_title {\r\n\tfont-weight: normal;\r\n\tline-height: 19px;\r\n}\r\n\r\na.support_txt {\r\n\ttext-decoration: none;\r\n\tfont-weight: normal;\r\n}\r\n\r\n/* �F������{ */\r\n.f_chuchoki_selected {\r\n\tbackground: #7030A0;\r\n\tcolor: #7030A0;\r\n}\r\n\r\n.f_koji_selected {\r\n\tbackground: #336;\r\n\tcolor: #333366;\r\n}\r\n\r\n.f_gyomu_selected {\r\n\tbackground: #930;\r\n\tcolor: #993300;\r\n}\r\n\r\n/* �^�C�g���јg */\r\n.title_label, .title_label_region {\r\n\theight: 20px;\r\n\tborder-radius: 8px 0 0 0;\r\n\tfont-weight: bold;\r\n\tfont-size: 14px;\r\n\tpadding-left: 10px;\r\n\tpadding-top: 2px;\r\n\tvertical-align: middle;\r\n\tvertical-align: middle;\r\n}\r\n\r\n/* �t�b�^���� */\r\n.ppi_footer {\r\n\tfont-family: Meiryo;\r\n\tfont-size: 10px;\r\n\tposition: absolute;\r\n\tleft: 0px;\r\n\tbottom: 0px;\r\n\twidth: 100%;\r\n\toverflow: hidden;\r\n\ttext-align: left;\r\n}\r\n\r\n/* �����@�֏ڍ׃t�b�^���� */\r\n.ppi_hachu_footer {\r\n\tfont-family: Meiryo;\r\n\tfont-size: 10px;\r\n\twidth: 100%;\r\n\ttext-align: left;\r\n}\r\n\r\n/* �����@�֏����_�ߋ��f�ڕ��{�^�� */\r\n#ibtKeisaiOld {\r\n\tborder-radius: 14px;\r\n\tborder: none;\r\n\twidth: 130px;\r\n\tposition: relative;\r\n\tbottom: 6px;\r\n\tborder: solid 2px #00000000;\r\n}\r\n\r\n/* �n��TOP���̑����́��̈ʒu */\r\nTD.mark {\r\n\ttext-align: center;\r
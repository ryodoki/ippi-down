            "mimeType": "text/css",
            "compression": 3055,
            "text": "/* �f�t�H���gCSS */\r\n\r\n\r\n/* body ��{�X�^�C�� */\r\nbody {\r\n\tbackground-color: white;\r\n}\r\n\r\na:link, a:visited, a:active {\r\n\tcolor: #336;\r\n}\r\n\r\na:hover {\r\n\tcolor: crimson;\r\n}\r\n\r\n#header_div {\r\n\tbackground-color: #039;\r\n}\r\n\r\n/* �^�C�g�� */\r\n#ppi_title {\r\n\tcolor: white;\r\n}\r\n\r\n/* �^�C�g���T�u */\r\n#ppi_sub {\r\n\tcolor: #ddf;\r\n}\r\n\r\n/* �n���{�^�� */\r\n.button_cls {\r\n\tbackground-color: #039;\r\n\tcolor: white;\r\n}\r\n\r\n/* �n���{�^���}�E�X�I�[�o�[ */\r\n.button_cls:hover {\r\n\t\tbackground-color: white;\r\n\t\tcolor: #003399;\r\n\t}\r\n\r\n.support_title {\r\n\tcolor: white;\r\n}\r\n\r\na.support_txt {\r\n\tcolor: white;\r\n}\r\n\r\n/* �F������{ */\r\n.f_chuchoki {\r\n\tbackground: #99F;\r\n}\r\n\r\n.f_koji {\r\n\tbackground: #639ACE;\r\n}\r\n\r\n.f_gyomu {\r\n\tbackground: #F90;\r\n}\r\n\r\n.chuchoki_item {\r\n\tcolor: #99F;\r\n}\r\n\r\n.koji_item {\r\n\tcolor: #639ACE;\r\n}\r\n\r\n.gyomu_item {\r\n\tcolor: #F90;\r\n}\r\n\r\n.hachukikan_item {\r\n\tcolor: #319A9C;\r\n}\r\n\r\n/* �^�C�g���јg */\r\n.title_label {\r\n\tcolor: white;\r\n\tbackground-color: lightseagreen;\r\n}\r\n\r\n.title_label_region {\r\n\tcolor: white;\r\n\tbackground-color: #3366CC;\r\n}\r\n\r\n/* �t�b�^���� */\r\n.ppi_footer,.ppi_hachu_footer {\r\n\tbackground-color: rgb( 0, 0,128);\r\n\tcolor: white;\r\n}\r\n\r\n/* �\\�[�g���x���̃����N������ */\r\nth.nolink a {\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n/* �����@�֏ڍ׉�� */\r\n/* ���m�点 */\r\n#tdInformation {\r\n\tbackground: #efefef;\r\n}\r\n\r\n/* �ߋ��f�ڕ��{�^�� */\r\n#ibtKeisaiOld {\r\n\tbackground-color: lightseagreen;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n#ibtKeisaiOld:hover {\r\n\tbackground-color: #FFFFFF;\r\n\tcolor: lightseagreen;\r\n}\r\n\r\nlabel.tabtext {\r\n\tcolor: #FFFFFF;\r\n\tfont-size: 12px;\r\n\tline-height: 20px;\r\n\tfont-weight: bold;\r\n}\r\n\r\ninput[type=submit].tab {\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n/* �A�C�R���{�^���̂���Z���̃X�^�C�� */\r\ntd.koji {\r\n\ttext-align: center;\r\n\twidth: 440px;\r\n\tcolor: #639ACE;\r\n}\r\n\r\ntd.gyomu {\r\n\ttext-align: center;\r\n\twidth: 440px;\r\n\tcolor: #FF9900;\r\n}\r\n\r\ntd.hachu {\r\n\ttext-align: center;\r\n\twidth: 200px;\r\n\tcolor: #319A9C;\r\n}\r\n\r\ntd.chuchoki {\r\n\ttext-align: center;\r\n\twidth: 200px;\r\n\tcolor: #9999FF;\r\n}\r\n\r\n.chuchokitab {\r\n\tbackground: #9999FF;\r\n}\r\n\r\n.selectchuchokitab {\r\n\tbackground: #7030A0;\r\n}\r\n\r\n.kojitab {\r\n\tbackground: #639ACE;\r\n}\r\n\r\n.selectkojitab {\r\n\tbackground: #333366;\r\n}\r\n\r\n.gyomutab {\r\n\tbackground: #FF9900;\r\n}\r\n\r\n.selectgyomutab {\r\n\tbackground: #993300;\r\n}\r\n\r\n.hachutab {\r\n\tbackground: #319A9C;\r\n}\r\n\r\n.selecthachutab {\r\n\tbackground: #1c5657;\r\n}\r\n\r\n#trNotes {\r\n\tcolor: red;\r\n}\r\n\r\n/* �r���i�ΐ��j */\r\n.hr_slash {\r\n\tbackground-image: repeating-linear-gradient(45deg,lightseagreen 0, lightseagreen 1px, transparent 0, transparent 50%);\r\n}\r\n"

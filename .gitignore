venv/
__pycache__/
*.pyc
.pytest_cache/
build/
dist/
logs/
scripts/snapshots/
release/
*.zip
# 配布ZIP内のexe等も管理外
release/**/ippi-down.exe
# 実設定は同梱しない（config.example.yaml のみリポジトリに含める）
config/config.yaml
# ルートに出力されるデバッグ用HTML（scraper が書き出す場合）
test_detail_page.html
# 配布用パック一時フォルダ
_review_pack/


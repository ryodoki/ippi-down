.env
.env.local

# 調査・デバッグ生成物（artifacts/配下は全てGit管理外）
artifacts/
# 調査ツールの出力（debug/ に保存した HTML/JSON）
debug/*.html
debug/*.json

# サイト変更監視スナップショット（investigate snapshot の出力）

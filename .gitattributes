# テキストファイルを自動的に正規化し、行末の設定を統一
* text=auto

# 明示的にテキストファイルとして扱う
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.spec text eol=lf

# バイナリファイルとして扱う
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.whl binary
